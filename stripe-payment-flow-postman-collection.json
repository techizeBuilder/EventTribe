{
  "info": {
    "_postman_id": "6a0c3e2f-8a24-4b54-8d90-4c5c19f5e0f3",
    "name": "Event Tribe - Stripe 80/20 Payment Flow",
    "description": "API endpoints for the Event Tribe Stripe 80/20 payment split flow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.environment.set('token', jsonData.accessToken || jsonData.token);",
                  "pm.environment.set('userId', jsonData.user._id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"organizer@example.com\",\n    \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Login as an organizer to get the authentication token"
          },
          "response": []
        }
      ],
      "description": "Authentication endpoints for getting tokens"
    },
    {
      "name": "1. Organizer Stripe Onboarding",
      "item": [
        {
          "name": "Create Stripe Connect Account",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.environment.set('stripeConnectAccountId', jsonData.accountId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"userId\": \"{{userId}}\",\n    \"email\": \"organizer@example.com\",\n    \"firstName\": \"John\",\n    \"lastName\": \"Organizer\",\n    \"businessName\": \"Event Productions\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/stripe/create-connect-account",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "stripe",
                "create-connect-account"
              ]
            },
            "description": "Create a Stripe Connect account for the organizer"
          },
          "response": []
        },
        {
          "name": "Create Onboarding Link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"accountId\": \"{{stripeConnectAccountId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/stripe/create-onboarding-link",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "stripe",
                "create-onboarding-link"
              ]
            },
            "description": "Create an onboarding link for the organizer to complete Stripe Connect account setup"
          },
          "response": []
        },
        {
          "name": "Check Account Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/stripe/account-status/{{stripeConnectAccountId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "stripe",
                "account-status",
                "{{stripeConnectAccountId}}"
              ]
            },
            "description": "Check if the organizer's Stripe Connect account is fully set up"
          },
          "response": []
        }
      ],
      "description": "Steps for organizer to set up Stripe Connect account for receiving payments"
    },
    {
      "name": "2. Attendee Ticket Purchase",
      "item": [
        {
          "name": "Create Payment Intent",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.environment.set('paymentIntentId', jsonData.paymentIntentId);",
                  "pm.environment.set('clientSecret', jsonData.clientSecret);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"amount\": 100,\n    \"eventId\": \"{{eventId}}\",\n    \"eventTitle\": \"Sample Event\",\n    \"ticketDetails\": {\n        \"ticketType\": \"VIP\",\n        \"quantity\": 1\n    }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/create-payment-intent",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "create-payment-intent"
              ]
            },
            "description": "Create a payment intent for ticket purchase with 80/20 split"
          },
          "response": []
        },
        {
          "name": "Confirm Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"paymentIntentId\": \"{{paymentIntentId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/confirm-payment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "confirm-payment"
              ]
            },
            "description": "Confirm the payment after client-side payment processing"
          },
          "response": []
        }
      ],
      "description": "Attendee purchasing a ticket with payment intent creation and confirmation"
    },
    {
      "name": "3. Organizer Payout Management",
      "item": [
        {
          "name": "Get Balance",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has balance data\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('success');",
                  "    pm.expect(jsonData).to.have.property('balance');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/organizer/payouts/commission-balance",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "organizer",
                "payouts",
                "commission-balance"
              ]
            },
            "description": "Get organizer's current balance (80% of processed payments)"
          },
          "response": []
        },
        {
          "name": "Request Payout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"amount\": 80,\n    \"paymentMethod\": \"bank_transfer\",\n    \"notes\": \"Payout for event tickets\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/organizer/payouts/request",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "organizer",
                "payouts",
                "request"
              ]
            },
            "description": "Request a payout to the organizer's bank account"
          },
          "response": []
        },
        {
          "name": "Get Payout History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/organizer/payouts/history",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "organizer",
                "payouts",
                "history"
              ]
            },
            "description": "Get the history of organizer's payout requests and transfers"
          },
          "response": []
        }
      ],
      "description": "Organizer managing their share of ticket sales (80%)"
    },
    {
      "name": "4. Admin Commission Management",
      "item": [
        {
          "name": "List Pending Payout Requests",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/payouts/requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "payouts",
                "requests"
              ]
            },
            "description": "Admin views all pending payout requests from organizers"
          },
          "response": []
        },
        {
          "name": "Approve Payout Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"requestId\": \"{{payoutRequestId}}\",\n    \"notes\": \"Approved after verification\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/payouts/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "payouts",
                "approve"
              ]
            },
            "description": "Admin approves a payout request to transfer the platform's share (20%)"
          },
          "response": []
        },
        {
          "name": "Reject Payout Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"requestId\": \"{{payoutRequestId}}\",\n    \"reason\": \"Insufficient documentation\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/payouts/reject",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "payouts",
                "reject"
              ]
            },
            "description": "Admin rejects a payout request if there are issues"
          },
          "response": []
        }
      ],
      "description": "Admin managing the platform's commission (20%)"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001",
      "type": "string"
    }
  ]
}
